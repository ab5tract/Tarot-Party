use v6.e.PREVIEW;

use Test;

use DB::SQLite;

use Tarot::Interpretation::Card;

### TODO: Fix the resource handling. Good enough for local usage though.
my $db;
lives-ok {
    $db = DB::SQLite.new: filename => "{~$*CWD}/resources/cards.db";
}, "Can create the database object";

ok $db.query('select count(1) from cards where deck_id = 1').value == 78,
    "We have the correct number of Rider-Waite-Smith cards";

my $card-interpretation;
lives-ok {
    $card-interpretation = Tarot::Interpretation::Card.new(:$db, :15card-id);
}, "Can load a card interpretation with ease";

done-testing;